# ─────────────────────────────────────────────────────────────────────────────
# Single env file for every service under microservices/.
# Copy to:   microservices/.env
# Do not commit .env — it stays listed in microservices/.gitignore
#
# Ports: use *_SERVICE_PORT keys so one file can start auth, schools, and users.
# Fallback: each service still reads PORT if you ever use only a legacy per-service .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

AUTH_SERVICE_PORT=8080
SCHOOLS_SERVICE_PORT=8081
USERS_SERVICE_PORT=8082
MEDIA_SERVICE_PORT=8083

# Server-to-server: schools-service → users-service when creating tenants (omit trailing slash)
USERS_SERVICE_INTERNAL_URL=http://localhost:8082

# Shared by auth, schools, and users — identical value on every process.
# This file is loaded with override: true so it wins over stray JWT_SECRET exports in your shell.
JWT_SECRET=dev-only-change-me-to-a-real-secret-min-16-chars

# auth-service only
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# ─── Cloud SQL (PostgreSQL), shared ───
#
# Public IP → DATABASE_HOST / DATABASE_PORT (Postgres usually 5432).
# Connection name PROJECT:REGION:INSTANCE is not the hostname; use DATABASE_INSTANCE_CONNECTION only
# for Unix/socket connectors on GCP. Local + Auth Proxy: leave it empty.
#
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=learning_platform
DATABASE_USER=app_user
DATABASE_PASSWORD=your_password

# Public Internet → true typical; Proxy to 127.0.0.1 → often false.
DATABASE_SSL=false

DATABASE_INSTANCE_CONNECTION=
DATABASE_SOCKET=
DATABASE_POOL_MAX=10

# CORS origins (comma-separated); * for lax dev-only
CORS_ORIGIN=http://localhost:5173

# ─── media-service (Google Cloud Storage) — optional until you run that service ───
# Bucket name only (no gs://). V4 signed URLs need a signer identity. Pick ONE approach:
#
# (A) Service account JSON key — set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json (WSL path if Node runs in WSL).
#
# (B) Impersonation (no key for the target SA) — use ADC (`gcloud auth application-default login`) and grant your
#     user roles/iam.serviceAccountTokenCreator on the target service account. Then set:
#       GCS_IMPERSONATE_SERVICE_ACCOUNT=learning-platform-service-account@YOUR_PROJECT_ID.iam.gserviceaccount.com
#     Or short name plus project:
#       GCS_IMPERSONATE_SERVICE_ACCOUNT=learning-platform-service-account
#       GCP_PROJECT_ID=your-gcp-project-id
#
# (C) On Cloud Run/GKE: attach a workload service account with Storage access; leave impersonation unset.
GCS_MEDIA_BUCKET=abdelhak-learning-media-bucket
GCS_IMPERSONATE_SERVICE_ACCOUNT=
GCP_PROJECT_ID=
# Object prefix: each tenant is GCS_TENANT_PREFIX/<school_id>/… (default tenants)
GCS_TENANT_PREFIX=tenants
MEDIA_SIGNED_URL_TTL_SECONDS=3600
