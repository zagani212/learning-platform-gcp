# ─────────────────────────────────────────────────────────────────────────────
# Single env file for every service under microservices/.
# Copy to:   microservices/.env
# Do not commit .env — it stays listed in microservices/.gitignore
#
# Ports: use *_SERVICE_PORT keys so one file can start auth, schools, and users.
# Fallback: each service still reads PORT if you ever use only a legacy per-service .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

AUTH_SERVICE_PORT=8080
SCHOOLS_SERVICE_PORT=8081
USERS_SERVICE_PORT=8082

# Shared by auth, schools, and users — must match across all three.
JWT_SECRET=dev-only-change-me-to-a-real-secret-min-16-chars

# auth-service only
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# ─── Cloud SQL (PostgreSQL), shared ───
#
# Public IP → DATABASE_HOST / DATABASE_PORT (Postgres usually 5432).
# Connection name PROJECT:REGION:INSTANCE is not the hostname; use DATABASE_INSTANCE_CONNECTION only
# for Unix/socket connectors on GCP. Local + Auth Proxy: leave it empty.
#
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=learning_platform
DATABASE_USER=app_user
DATABASE_PASSWORD=your_password

# Public Internet → true typical; Proxy to 127.0.0.1 → often false.
DATABASE_SSL=false

DATABASE_INSTANCE_CONNECTION=
DATABASE_SOCKET=
DATABASE_POOL_MAX=10

# CORS origins (comma-separated); * for lax dev-only
CORS_ORIGIN=http://localhost:5173
